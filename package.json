{
  "name": "ki-icons",
  "version": "1.0.0",
  "description": "Hand-drawn, full-colour food, category, trophy, currency, world, decoration and tree illustrations: a Nuxt module and an Iconify icon set (prefix `ki`).",
  "keywords": [
    "icons",
    "iconify",
    "food",
    "illustrations",
    "nuxt",
    "nuxt-module",
    "nuxt-icon",
    "vuetify"
  ],
  "license": "MIT",
  "author": "Gabriele Vinai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriVinaiGit/ki-icons.git"
  },
  "type": "module",
  "types": "./nuxt.d.mts",
  "exports": {
    ".": {
      "types": "./nuxt.d.mts",
      "default": "./nuxt.mjs"
    },
    "./icons.json": "./icons.json",
    "./names.json": "./names.json",
    "./package.json": "./package.json"
  },
  "files": [
    "nuxt.mjs",
    "nuxt.d.mts",
    "icons.json",
    "names.json",
    "svg"
  ],
  "peerDependencies": {
    "@nuxt/icon": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/icon": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/catalog.mjs",
    "test": "node scripts/build.mjs --check",
    "prepublishOnly": "npm test"
  }
}
